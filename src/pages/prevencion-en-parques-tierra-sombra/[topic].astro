---
import ParkTopicSection from '../../components/ParkTopicSection.astro';
import Layout from '../../layouts/Layout.astro';
import { parkTopics } from '../../data/parkTopics';

export function getStaticPaths() {
  return parkTopics.map((topic, index) => ({
    params: { topic: topic.id },
    props: { topic, index },
  }));
}

const { topic, index } = Astro.props;
---

<Layout title={`GESTIÓN DE RIESGO EN PARQUES - ${topic.title}`} mode="light">
  <main class="pc-theme-tierra min-h-screen bg-[var(--color-bg-light)]">
    <ParkTopicSection
      topic={topic}
      index={index}
      backHref="/prevencion-en-parques-tierra-sombra"
    />
  </main>
</Layout>
